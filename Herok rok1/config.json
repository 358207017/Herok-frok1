{
    "engine": {
        "name": "Herok Rok1",
        "version": "1.0.0",
        "maxGaussians": 1000000000,
        "targetFPS": 60,
        "memoryLimitMB": 1024
    },
    "rendering": {
        "fov": 65,
        "nearPlane": 0.1,
        "farPlane": 1000.0,
        "renderScale": 1.0,
        "backgroundColor": [0, 0, 0, 1],
        "shaderQuality": "high"
    },
    "lod": {
        "levels": 5,
        "distances": [5, 20, 50, 150, 500],
        "qualityMultipliers": [1.0, 0.75, 0.5, 0.3, 0.15]
    },
    "streaming": {
        "chunkSize": 100000,
        "maxConcurrentChunks": 12,
        "cacheSize": 50,
        "preloadDistance": 100
    },
    "optimization": {
        "enableFrustumCulling": true,
        "enableOcclusionCulling": false,
        "sortPrecision": "high",
        "useWorkerThreads": true
    }
}